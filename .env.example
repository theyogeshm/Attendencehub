# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...YOUR_ANON_KEY_HERE

# ── Admin ─────────────────────────────────────────────────────────────────────
# The Google account email that has admin panel access.
# This is checked client-side; real enforcement is done via Supabase RLS policies.
VITE_ADMIN_EMAIL=your-admin@gmail.com

# ── App URL ───────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: your production deployment URL (used as OAuth redirect target)
VITE_APP_URL=https://your-app.com
